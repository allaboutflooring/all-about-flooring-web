# Copy to .env.local for local dev. Netlify: set these in Site settings > Environment variables.
VITE_GA_ID=
VITE_GOOGLE_MAPS_EMBED_KEY=

# Server-side only (not exposed to the browser). Enable Places API
# (or Places API New) on the key. Restart `npm run dev` after adding it.
GOOGLE_PLACES_API_KEY=
